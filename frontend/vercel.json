{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "/api/v1"
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://stock-dashboard-backend.onrender.com/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
