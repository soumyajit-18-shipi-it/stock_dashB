{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "/api/v1"
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://stock-dashboard-production-9593.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
