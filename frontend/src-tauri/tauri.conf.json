{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Intelligence Dashboard",
  "version": "1.0.0",
  "identifier": "org.stockintelligence.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stock Intelligence Dashboard",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"],
    "category": "Finance"
  }
}
