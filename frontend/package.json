{
  "name": "stock-intelligence-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,html,md}\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dead-code": "knip --no-progress",
    "dep-check": "depcheck --ignores=\"@types/*,eslint-*,@eslint/*,typescript-eslint,vite,@vitejs/*,postcss,autoprefixer,tailwindcss\"",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "license-check": "license-checker --onlyAllow 'MIT;Apache-2.0;BSD-3-Clause;BSD-2-Clause;ISC;CC0-1.0;Unlicense;Python-2.0;MPL-2.0' --production --csv",
    "license-check:dev": "license-checker --onlyAllow 'MIT;Apache-2.0;BSD-3-Clause;BSD-2-Clause;ISC;CC0-1.0;Unlicense;Python-2.0;MPL-2.0' --development --csv",
    "circular-deps": "madge --circular --extensions ts,tsx src",
    "outdated": "npm outdated",
    "pre-commit:run": "pre-commit run --all-files",
    "pre-push:run": "echo 'Run \"git push\" to trigger the Husky pre-push pipeline.'",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "plotly.js-dist-min": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-plotly.js": "^3.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "depcheck": "^1.4.7",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "npm-check-updates": "^17.1.18",
    "playwright": "^1.60.0",
    "postcss": "^8.4.35",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.8"
  }
}
