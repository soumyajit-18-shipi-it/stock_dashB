{
    "buildCommand":  "cd frontend \u0026\u0026 npm install \u0026\u0026 npm run build",
    "outputDirectory":  "frontend/dist",
    "rewrites":  [
                     {
                         "source":  "/api/(.*)",
                         "destination":  "https://stock-dashboard-production-9593.up.railway.app/api/$1"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ],
    "env":  {
                "VITE_API_URL":  "/api/v1"
            }
}
